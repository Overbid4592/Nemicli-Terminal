# Sensible Daten & Umgebung
.env
# .env.example bleibt im Repo – die README verweist darauf.

# Python
venv/
.runtime/
__pycache__/
*.pyc

# Builds (NemiCLI.spec bleibt im Repo – das ist der Bauplan der exe)
build/
dist/
*.exe

# Große Modelle & GPU-Binaries (49 GB – liegen nur lokal)
/Models/
/ModelGGUF/
/Vision/

# Persönliche Daten: Chat-Verlauf, Gedächtnis, gemalte Bilder, Übungen
chats/
learned/
Bilder/
NemiSandbox/
Befehle/
Persoenlichkeiten/
memory.md

# Logs & Verlauf
logs/
*.log
.cli_history

# Claude-Code-Sitzungseinstellungen (rechnerspezifisch)
.claude/settings.local.json

# Lokale Konfig (aktives Modell etc.)
nemicli.config.json
nemicli.config.json.bak
nemicli.config.json.tmp
# Lebenszeichen/Briefkasten des laufenden Fensters (Rechtsklick-Menue)
.nemicli.alive
.nemicli.inbox

# Gesicherte Gespraeche (F12) - privat, gehoeren nicht ins Repo
Gespraeche/
!Gespraeche/LIES-MICH.txt

# Ablage des Coding-Assistenten - gehoert zum jeweiligen Projekt
.nemicli/
# Ablage des frueheren /workspace in alten Projekten
.workspace/

# Eigene Internet-Freigaben (einstellung_aendern)
allowlist_eigen.json

# Zeitplan-Aufträge, Hintergrund-Berichte, Vorschläge der Persönlichkeit, eigene Sperrliste
Zeitplan/
Berichte/
Vorschläge/
schreibsperre.json

# Sicherungskopien von Editoren
*.bak

# Sicherungen (/backup)
Backup/
/kernel-cache/

# Zwischenstände des LoRA-Trainings
*_stand.safetensors
