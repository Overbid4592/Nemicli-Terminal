# Kopiere diese Datei zu ".env" und trage die Keys ein, die du nutzen willst.
# NemiCLI zeigt bei /model nur Anbieter an, deren Key hier gesetzt ist.
# Lokale Modelle (Ordner Models/) brauchen KEINEN Key.

# --- Anthropic (Claude) ---  https://console.anthropic.com/settings/keys
# Einziger Anbieter mit Denk-Stärke (/staerke).
ANTHROPIC_API_KEY=

# --- OpenAI (GPT) ---  https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Google (Gemini) ---  https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Mistral ---  https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# --- Cohere (Command) ---  https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# --- Perplexity (Sonar, mit Internet) ---  https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# --- DeepSeek ---  https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# --- xAI (Grok) ---  https://console.x.ai
XAI_API_KEY=

# --- Groq (sehr schnell) ---  https://console.groq.com/keys
GROQ_API_KEY=

# --- OpenRouter (ein Key, viele Anbieter) ---  https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Ollama Cloud + Web-Suche ---
# Key holen: https://ollama.com/settings/keys
# Doku Suche: https://docs.ollama.com/capabilities/web-search
# Derselbe Key gilt für Cloud-Modelle UND web_suche.
OLLAMA_API_KEY=

# Optional: anderer Ollama-Host (Default http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434